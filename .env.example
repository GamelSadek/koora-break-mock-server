# ─────────────────────────────────────────────────────────────────────────────
# Mock StatsPerform Server — configuration
# Copy to `.env` and edit, or export in your shell. Every var has a sane default
# baked in (see src/config/configuration.ts), so `.env` is optional.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP + WebSocket port (REST endpoints and the ws feed share this port).
PORT=3001

# ── Simulation ───────────────────────────────────────────────────────────────

# How many simultaneous matches to run (spec calls for 10–20).
MATCH_COUNT=15

# Real milliseconds per simulated minute. 1000 => a 90' match runs in ~90s.
# Lower this (e.g. 200) to make matches fly by for a quick demo.
SIM_MINUTE_MS=1000

# When a match reaches FULL_TIME, replace it with a fresh one so the server
# produces events indefinitely. Set false to let matches finish and stop.
RESTART_ON_FULLTIME=true

# ── Chaos master switch ──────────────────────────────────────────────────────

# Master off-switch. When false, ALL chaos rates below are forced to 0 and the
# feed is perfectly clean — ideal for developing the consumer against a calm
# baseline. Flip to true (and optionally crank the rates) to stress-test.
CHAOS_ENABLED=false

# ── Chaos: duplicates ────────────────────────────────────────────────────────
# Re-send the exact same event (same eventId + seq) 2–3 times, back-to-back or a
# few events later. Realistic default; crank to 0.15–0.30 to demo consumer dedup.
DUP_RATE=0.02

# ── Chaos: out-of-order ──────────────────────────────────────────────────────
# Hold an event back briefly and deliver it AFTER later events, so seq arrives
# non-monotonically ON THE WIRE (seq itself stays correct). Held frames are
# always flushed before FULL_TIME — reorder never drops an event.
# Crank REORDER_RATE to ~0.15 to demo reorder-tolerance.
REORDER_RATE=0.02
REORDER_MAX_DELAY_MS=800

# ── Chaos: malformed ─────────────────────────────────────────────────────────
# Deliver an in-play event ONLY in corrupted form (missing field / bad type /
# unknown type / invalid JSON). The clean frame never reaches the socket, so the
# consumer must heal the resulting seq gap via the REST catch-up endpoint.
# NEVER applied to lifecycle events (KICK_OFF/HALF_TIME/…/FULL_TIME).
# Genuinely rare; crank to 0.05–0.10 to demo validation + gap recovery.
MALFORMED_RATE=0.005

# ── Chaos: burst (derby moment) ──────────────────────────────────────────────
# Rapidly GENERATE genuine new canonical events for ONE match within
# BURST_WINDOW_MS (mixed cards/subs/offsides, not goals; spread over 1–2 minutes).
# These get real seq and enter the canonical log.
#   • SPONTANEOUS (ambient) bursts are SMALL & realistic — BURST_AMBIENT_SIZE_MIN..MAX.
#   • The big rate-stress burst is ON-DEMAND: POST /control/burst/:matchId {"size":40}
#     (uses BURST_SIZE_MIN..MAX when no size is given).
BURST_ENABLED=true
BURST_RANDOM_PROBABILITY=0.02
BURST_AMBIENT_SIZE_MIN=3
BURST_AMBIENT_SIZE_MAX=6
BURST_SIZE_MIN=20
BURST_SIZE_MAX=40
BURST_WINDOW_MS=1000

# ── Reversal probabilities ───────────────────────────────────────────────────
# Fraction of goals later cancelled (VAR), and reds later rescinded.
GOAL_CANCEL_PROBABILITY=0.06
RED_RESCIND_PROBABILITY=0.10
